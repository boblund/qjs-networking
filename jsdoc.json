{
  "source": {
    "includePattern": ".+\\.(m?js(doc|x)?)$"
  },
	"opts": {
    "destination": "./docs/",
    "recurse": true
  },
  "templates": {
    "default": {
      "layoutFile": "./tooling/layout.tmpl",
      "staticFiles": {
        "include": ["./tooling/custom.css", "./tooling/custom.js"]
      }
    }
  }
}
